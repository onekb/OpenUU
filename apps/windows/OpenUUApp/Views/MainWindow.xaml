<Window x:Class="OpenUU.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:OpenUU.Views"
        Title="OpenUU"
        Width="960" Height="640"
        MinWidth="880" MinHeight="590"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource AppWindowBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================================ -->
        <!-- LEFT SIDEBAR NAVIGATION RAIL (ToDesk / UU远程 / OpenUU Mac Style) -->
        <!-- ================================================================ -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarBg}" MouseLeftButtonDown="DraggableTopRegion_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand Header -->
            <StackPanel Grid.Row="0" Margin="16,20,16,18" Orientation="Horizontal">
                <Image x:Name="BrandLogoImage"
                       Width="38" Height="38"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="OpenUU"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="SidebarVersionText"
                                   Text="v0.7.1"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="6,2,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="SidebarBrandSubText"
                               Text="工作伴侣，永久免费。"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}" />
                    <Button x:Name="SidebarUpdatePillBtn"
                            Content="⬆ 发现新版本 · 点击更新"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0,2,0,0"
                            Cursor="Hand"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#D97706"
                            Click="OpenUpdateDialogBtn_Click" />
                </StackPanel>
            </StackPanel>

            <!-- 4 Navigation Tabs -->
            <StackPanel Grid.Row="1" Margin="10,0,10,0">
                <Button x:Name="NavRemoteBtn" Click="NavRemoteBtn_Click" FocusVisualStyle="{x:Null}" Margin="0,0,0,4" Cursor="Hand" BorderThickness="0" Padding="12,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <TextBlock x:Name="TabTxt" Text="🖥  远程控制" FontSize="13.5" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="FontWeight" Value="Normal" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabBd" Property="Background" Value="#E2E8F0" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="NavDevicesBtn" Click="NavDevicesBtn_Click" FocusVisualStyle="{x:Null}" Margin="0,0,0,4" Cursor="Hand" BorderThickness="0" Padding="12,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <TextBlock Text="💻  设备列表" FontSize="13.5" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" />
                                    <Border x:Name="DevicesCountPill"
                                            HorizontalAlignment="Right"
                                            CornerRadius="10"
                                            Padding="7,2"
                                            Background="#E2E8F0"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="DevicesCountText" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="FontWeight" Value="Normal" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabBd" Property="Background" Value="#E2E8F0" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="NavSecurityBtn" Click="NavSecurityBtn_Click" FocusVisualStyle="{x:Null}" Margin="0,0,0,4" Cursor="Hand" BorderThickness="0" Padding="12,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="🛡  安全与画质" FontSize="13.5" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="FontWeight" Value="Normal" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabBd" Property="Background" Value="#E2E8F0" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="NavNetworkBtn" Click="NavNetworkBtn_Click" FocusVisualStyle="{x:Null}" Margin="0,0,0,4" Cursor="Hand" BorderThickness="0" Padding="12,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="📡  网络与日志" FontSize="13.5" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="FontWeight" Value="Normal" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabBd" Property="Background" Value="#E2E8F0" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Bottom Global Status Card -->
            <Border Grid.Row="2"
                    Margin="10,8,10,12"
                    Padding="11"
                    CornerRadius="10"
                    Background="#E8EEF5"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="SidebarHostDot" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0" />
                            <TextBlock x:Name="SidebarHostLabel" Text="本机被控：未开启" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <Button x:Name="SidebarHostToggleBtn"
                                Content="开启"
                                HorizontalAlignment="Right"
                                Padding="8,2"
                                FontSize="11"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ToggleHostBtn_Click" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="SidebarClientDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0" />
                        <TextBlock x:Name="SidebarClientSummary" Text="并发远控：0 台 · 0 窗" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>

                    <Button x:Name="SidebarDisconnectAllBtn"
                            Content="全部断开远控"
                            Margin="0,8,0,0"
                            Padding="8,4"
                            FontSize="11"
                            Visibility="Collapsed"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="DisconnectAllBtn_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

        <!-- ================================================================ -->
        <!-- MAIN RIGHT WORKSPACE                                             -->
        <!-- ================================================================ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Draggable Header Bar + Window Controls -->
            <Grid Grid.Row="0" Background="{StaticResource CardBg}" MouseLeftButtonDown="DraggableTopRegion_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="22,14,12,12">
                    <TextBlock x:Name="PageHeaderTitle" Text="远程控制" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="PageHeaderSubtitle" Text="局域网与异地自动直连 · 支持单应用无缝窗口与整屏远程桌面" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <Button x:Name="TopAddDeviceBtn"
                        Grid.Column="1"
                        Content="＋ 添加受控设备"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Padding="12,6"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddDeviceBtn_Click" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource WindowCaptionBtnStyle}" Click="MinimizeWindow_Click" ToolTip="最小化">
                        <Canvas Width="10" Height="10">
                            <Path Data="M 0,5 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                        </Canvas>
                    </Button>
                    <Button x:Name="MaxRestoreBtn" Style="{StaticResource WindowCaptionBtnStyle}" Click="MaxRestoreWindow_Click" ToolTip="最大化 / 还原">
                        <Canvas Width="10" Height="10">
                            <Path x:Name="MaxRestoreIconPath" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                        </Canvas>
                    </Button>
                    <Button Style="{StaticResource WindowCloseBtnStyle}" Click="CloseWindow_Click" ToolTip="关闭主面板（连接活跃时驻留系统托盘）">
                        <Canvas Width="10" Height="10">
                            <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                        </Canvas>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource DividerBrush}" />

            <!-- ============================================================ -->
            <!-- TAB PAGES CONTAINER                                          -->
            <!-- ============================================================ -->
            <Grid Grid.Row="2">

                <!-- ======================================================== -->
                <!-- PAGE 1: 远程控制首页 (Dual Hero Cards + LAN + Active Dock) -->
                <!-- ======================================================== -->
                <ScrollViewer x:Name="PageRemoteHome" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Hero Card: 允许控制本机 -->
                            <Border x:Name="HostHeroCard" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🖥  允许控制本机" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <Border x:Name="HomeAdminBadge"
                                                    Margin="8,0,0,0"
                                                    Padding="6,2"
                                                    CornerRadius="6"
                                                    Background="{StaticResource OnlineGreenSoft}"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="🛡 管理员" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource OnlineGreen}" />
                                            </Border>
                                            <Button x:Name="HomeElevateBtn"
                                                    Content="🛡 提权运行"
                                                    Margin="8,0,0,0"
                                                    Padding="7,2"
                                                    FontSize="10.5"
                                                    ToolTip="当前为普通用户权限，Windows 会拦截对管理员窗口（如提权终端/Electron/任务管理器）的鼠标点击；点击一键以管理员重启并自动恢复被控"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="RelaunchAdminBtn_Click" />
                                        </StackPanel>
                                        <Button x:Name="HeroHostPillBtn"
                                                HorizontalAlignment="Right"
                                                Content="⚡ 点击开启被控"
                                                Padding="12,5"
                                                FontSize="11.5"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="ToggleHostBtn_Click" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,14" />

                                    <TextBlock Text="本机设备代码" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock x:Name="MyDeviceCodeText"
                                                   Text="--- --- ---"
                                                   FontFamily="Consolas"
                                                   FontSize="25"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="复制"
                                                Margin="12,0,0,0"
                                                Padding="10,4"
                                                FontSize="11.5"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="CopyMyCodeBtn_Click" />
                                    </StackPanel>

                                    <TextBlock Text="本机访问密码（验证码）" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBox x:Name="HostPinBox"
                                                 Width="148"
                                                 FontFamily="Consolas"
                                                 FontSize="15.5"
                                                 FontWeight="SemiBold"
                                                 Visibility="Collapsed"
                                                 Style="{StaticResource RoundedTextBoxStyle}"
                                                 TextChanged="HostPinBox_TextChanged" />
                                        <TextBlock x:Name="HostPinMaskedText"
                                                   Width="148"
                                                   FontFamily="Consolas"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Visibility="Visible" />
                                        <Button x:Name="TogglePinEyeBtn"
                                                Content="👁"
                                                ToolTip="点击显示/隐藏本机访问密码"
                                                Margin="8,0,0,0"
                                                Padding="10,5"
                                                FontSize="12"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="TogglePinEyeBtn_Click" />
                                        <Button x:Name="RegenPinBtn"
                                                Content="刷新密码 ▾"
                                                Margin="8,0,0,0"
                                                Padding="10,5"
                                                FontSize="11.5"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="RegenPinBtn_Click" />
                                    </StackPanel>

                                    <!-- Stopped State Buttons -->
                                    <Grid x:Name="HostStoppedActionRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="⚡ 点击开启被控"
                                                Padding="14,10"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="StartHostBtn_Click" />
                                        <Button Grid.Column="2"
                                                Content="复制邀请"
                                                Padding="14,10"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="CopyInviteBtn_Click" />
                                    </Grid>

                                    <!-- Running State Buttons -->
                                    <Grid x:Name="HostRunningActionRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="复制代码与密码"
                                                Padding="12,10"
                                                Style="{StaticResource GreenButtonStyle}"
                                                Click="CopyInviteBtn_Click" />
                                        <Button Grid.Column="2"
                                                Content="🔗 直连串"
                                                Padding="12,10"
                                                ToolTip="未部署寻址服务器时，复制 openuu:// 连接串发给对方即可跨网穿透连接"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="CopyTicketBtn_Click" />
                                        <Button Grid.Column="4"
                                                Content="关闭"
                                                Padding="12,10"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Click="ToggleHostBtn_Click" />
                                    </Grid>

                                    <TextBlock x:Name="HostCoordStatusLabel"
                                               Text="开启后支持异地与局域网设备连入（输错5次自动封禁防爆破）"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,12,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Right Hero Card: 远程控制伙伴设备 -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="🚀  远程控制伙伴设备" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                        <Button x:Name="QuickBookPickerBtn"
                                                Content="从设备簿选择 ▾"
                                                HorizontalAlignment="Right"
                                                Padding="10,4"
                                                FontSize="11.5"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="QuickBookPickerBtn_Click" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,14" />

                                    <TextBlock Text="伙伴设备代码 / 跨网连接串 / IP或域名" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                    <views:SmartTargetTextBox x:Name="QuickTargetBox"
                                                              FontSize="14.5"
                                                              Style="{StaticResource RoundedTextBoxStyle}"
                                                              views:UiAssist.Placeholder="输入 9 位设备码 / openuu:// / IP"
                                                              ToolTip="例如：601 550 599 或 openuu://… 或 192.168.1.10"
                                                              Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="访问密码（已保存或已信任免填）" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox x:Name="QuickPasswordSecureBox"
                                                             Grid.Column="0"
                                                             FontFamily="Consolas"
                                                             Style="{StaticResource RoundedPasswordBoxStyle}"
                                                             PasswordChanged="QuickPasswordSecureBox_PasswordChanged" />
                                                <TextBox x:Name="QuickPasswordBox"
                                                         Grid.Column="0"
                                                         Visibility="Collapsed"
                                                         FontFamily="Consolas"
                                                         Style="{StaticResource RoundedTextBoxStyle}"
                                                         views:UiAssist.Placeholder="可留空免密连接"
                                                         TextChanged="QuickPasswordBox_TextChanged" />
                                                <Button x:Name="ToggleQuickPwEyeBtn"
                                                        Grid.Column="2"
                                                        Content="👁"
                                                        ToolTip="点击显示/隐藏访问密码"
                                                        Padding="9,5"
                                                        FontSize="12"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Click="ToggleQuickPwEyeBtn_Click" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="直连端口" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                                            <TextBox x:Name="QuickPortBox"
                                                     Text="39481"
                                                     FontFamily="Consolas"
                                                     Style="{StaticResource RoundedTextBoxStyle}"
                                                     TextChanged="QuickPortBox_TextChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="QuickConnectAppsBtn"
                                                Grid.Column="0"
                                                Content="连接并挑应用"
                                                Padding="14,10"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="QuickConnectAppsBtn_Click" />
                                        <Button x:Name="QuickConnectDesktopBtn"
                                                Grid.Column="2"
                                                Content="🖥 直开远程桌面"
                                                Padding="14,10"
                                                ToolTip="连上后立即弹出对方整台电脑桌面窗口"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="QuickConnectDesktopBtn_Click" />
                                    </Grid>

                                    <ContentControl x:Name="QuickConnectStatusHost"
                                                    Visibility="Collapsed"
                                                    Margin="0,10,0,0" />

                                    <TextBlock Text="连接成功后将自动收录至「设备列表」，支持多台 Mac / Windows 受控机同时在线操控。"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,12,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- LAN Discovery Strip -->
                        <StackPanel x:Name="LanDiscoverySection" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Text="⚡ 同局域网在线设备（&lt;2ms 极速直连）"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,8" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:UiAssist.HorizontalWheelScroll="True">
                                <StackPanel x:Name="LanPeersHostPanel" Orientation="Horizontal" />
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Active Multi-Host Concurrent Control Dock -->
                        <StackPanel x:Name="ActiveSessionsHomeSection" Margin="0,18,0,0" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="ActiveSessionsHomeHeading"
                                           Text="当前并行操控中的设备 (0)"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <Button Content="进入设备列表管理全部窗口 ➔"
                                        HorizontalAlignment="Right"
                                        Padding="8,2"
                                        FontSize="11.5"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="NavDevicesBtn_Click" />
                            </Grid>
                            <StackPanel x:Name="ActiveSessionsCardsPanel" />
                        </StackPanel>

                        <!-- Quick Recent Devices Strip (shown when idle & device book non-empty) -->
                        <StackPanel x:Name="RecentDevicesHomeSection" Margin="0,18,0,0" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="★ 常用受控设备（免输一键连）"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}" />
                                <Button x:Name="ManageAllDevicesLinkBtn"
                                        Content="管理全部"
                                        HorizontalAlignment="Right"
                                        Padding="8,2"
                                        FontSize="11.5"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="NavDevicesBtn_Click" />
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:UiAssist.HorizontalWheelScroll="True">
                                <StackPanel x:Name="RecentDevicesStripPanel" Orientation="Horizontal" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================== -->
                <!-- PAGE 2: 设备列表 (Device Book + Resizable App Drawer)     -->
                <!-- ======================================================== -->
                <Grid x:Name="PageDeviceList" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="DrawerSplitterRow" Height="0" />
                        <RowDefinition x:Name="DrawerContentRow" Height="0" />
                    </Grid.RowDefinitions>

                    <!-- Search & Group Filter Bar -->
                    <Grid Grid.Row="0" Margin="22,12,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="DeviceSearchBox"
                                 Grid.Column="0"
                                 FontSize="12.5"
                                 Style="{StaticResource RoundedTextBoxStyle}"
                                 views:UiAssist.Placeholder="🔍 搜索备注名 / 设备码 / IP..."
                                 ToolTip="搜索备注名 / 设备码 / IP..."
                                 TextChanged="DeviceSearchBox_TextChanged" />

                        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" views:UiAssist.HorizontalWheelScroll="True">
                            <StackPanel x:Name="GroupFilterPillsPanel" Orientation="Horizontal" />
                        </ScrollViewer>

                        <Button Grid.Column="3"
                                Content="↻ 刷新在线状态"
                                Padding="12,6"
                                Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="RefreshOnlineBtn_Click" />
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource DividerBrush}" />

                    <!-- Device Cards Grid or Empty State -->
                    <Grid Grid.Row="2">
                        <StackPanel x:Name="EmptyDevicesPlaceholder"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="💻" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock x:Name="EmptyDevicesTitle"
                                       Text="尚未添加受控设备"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="将家里、公司或服务器的 Mac / Windows 电脑添加到设备列表，保存备注名与密码后即可随时一键并发操控。"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Width="390"
                                       Margin="0,6,0,14" />
                            <Button Content="＋ 添加第一台受控设备"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="AddDeviceBtn_Click" />
                        </StackPanel>

                        <ScrollViewer x:Name="DevicesGridScroller" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="DevicesWrapPanel" Margin="18" />
                        </ScrollViewer>
                    </Grid>

                    <!-- Resizable Handle -->
                    <GridSplitter Grid.Row="3"
                                  Height="8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ModernHorizontalSplitterStyle}"
                                  ShowsPreview="False"
                                  ResizeDirection="Rows" />

                    <!-- Bottom Docked Multi-Host Concurrent App Launcher -->
                    <Grid Grid.Row="4" Background="{StaticResource CardBg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,7,18,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="并行操控工作台:"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" views:UiAssist.HorizontalWheelScroll="True">
                                <StackPanel x:Name="DrawerSessionTabsPanel" Orientation="Horizontal" />
                            </ScrollViewer>

                            <Button Grid.Column="2"
                                    Content="刷新应用列表"
                                    Padding="10,4"
                                    FontSize="11.5"
                                    Margin="8,0,6,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DrawerRefreshAppsBtn_Click" />

                            <Button x:Name="DrawerCollapseBtn"
                                    Grid.Column="3"
                                    Content="▾"
                                    Padding="8,4"
                                    FontSize="11.5"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="DrawerCollapseBtn_Click" />
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource DividerBrush}" />

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="DrawerAppsWrapPanel" Margin="16,10,16,10" />
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ======================================================== -->
                <!-- PAGE 3: 安全与画质 (FPS / Mode / Clipboard / Permissions) -->
                <!-- ======================================================== -->
                <ScrollViewer x:Name="PageSecurityQuality" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <!-- 1. Frame Rate & Capture -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="画面流畅度与被控窗口捕获" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="最高帧率档位:" Width="118" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                    <Button x:Name="Fps30Btn" Content="30 FPS (省流最稳)" Margin="0,0,8,0" Padding="12,6" Click="Fps30Btn_Click" />
                                    <Button x:Name="Fps45Btn" Content="45 FPS (均衡推荐)" Margin="0,0,8,0" Padding="12,6" Click="Fps45Btn_Click" />
                                    <Button x:Name="Fps60Btn" Content="60 FPS (局域网丝滑)" Padding="12,6" Click="Fps60Btn_Click" />
                                </StackPanel>

                                <CheckBox x:Name="DynResCheck"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          Content="动态分辨率加速（高速滚动/跨网中继时智能调节采样，静止恢复超清锐利文字）"
                                          Margin="0,2,0,11"
                                          FontSize="12.5"
                                          Checked="QualityCheck_Changed"
                                          Unchecked="QualityCheck_Changed" />

                                <CheckBox x:Name="DebugHudCheck"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          Content="显示画面调试浮窗（远程窗口左下角展示 H.264/HEVC、实时码率与解码耗时）"
                                          FontSize="12.5"
                                          Checked="QualityCheck_Changed"
                                          Unchecked="QualityCheck_Changed" />
                            </StackPanel>
                        </Border>

                        <!-- 2. Multi-Host Synergy, Remote Audio & Keyboard -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="多机键鼠、远端音频与剪贴板无缝协同" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14" />

                                <CheckBox x:Name="RemoteAudioCheck"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          Content="远端音频实时传输（将当前远控应用或整屏桌面声音实时传至控制端）"
                                          Margin="0,0,0,11"
                                          FontSize="12.5"
                                          Checked="QualityCheck_Changed"
                                          Unchecked="QualityCheck_Changed" />

                                <CheckBox x:Name="MuteHostAudioCheck"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          Content="远控传声时被控端电脑自动静音（断开远控后自动恢复本机外放）"
                                          Margin="0,0,0,11"
                                          FontSize="12.5"
                                          Checked="QualityCheck_Changed"
                                          Unchecked="QualityCheck_Changed" />

                                <CheckBox x:Name="ClipboardSyncCheck"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          Content="跨多机双向剪贴板同步（复制文字 / 图片 / 文件自动同步至所有已连设备）"
                                          Margin="0,0,0,11"
                                          FontSize="12.5"
                                          Checked="QualityCheck_Changed"
                                          Unchecked="QualityCheck_Changed" />

                                <CheckBox x:Name="NotifSyncCheck"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          Content="远端消息通知横幅与本地任务栏独立图标未读红点同步"
                                          Margin="0,0,0,11"
                                          FontSize="12.5"
                                          Checked="QualityCheck_Changed"
                                          Unchecked="QualityCheck_Changed" />

                                <CheckBox x:Name="MapCtrlToCmdCheck"
                                          Style="{StaticResource ModernToggleSwitchStyle}"
                                          Content="操控 Mac 时智能将 Ctrl 快捷键映射为 Mac Command (⌘) 键（复制/粘贴/撤销/全选与 Windows 习惯一致）"
                                          Margin="0,0,0,12"
                                          FontSize="12.5"
                                          Checked="QualityCheck_Changed"
                                          Unchecked="QualityCheck_Changed" />

                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,12" />

                                <WrapPanel>
                                    <CheckBox x:Name="SilentClickCheck"
                                              Style="{StaticResource ModernToggleSwitchStyle}"
                                              Content="静默点击模式（点击后归位本机光标）"
                                              Margin="0,0,26,6"
                                              FontSize="12.5"
                                              Checked="QualityCheck_Changed"
                                              Unchecked="QualityCheck_Changed" />
                                    <CheckBox x:Name="HoverCursorCheck"
                                              Style="{StaticResource ModernToggleSwitchStyle}"
                                              Content="同步远端光标形状"
                                              Margin="0,0,26,6"
                                              FontSize="12.5"
                                              Checked="QualityCheck_Changed"
                                              Unchecked="QualityCheck_Changed" />
                                    <CheckBox x:Name="PreventSleepCheck"
                                              Style="{StaticResource ModernToggleSwitchStyle}"
                                              Content="被控期间阻止休眠息屏"
                                              Margin="0,0,0,6"
                                              FontSize="12.5"
                                              Checked="QualityCheck_Changed"
                                              Unchecked="QualityCheck_Changed" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. Windows Host System Capabilities -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="本机作为 Windows 被控端环境状态" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />

                                <TextBlock Text="✅  DWM 独立窗口合成捕获 (PW_RENDERFULLCONTENT) + DXGI 高速桌面复制：已就绪（无需额外弹窗授权）"
                                           FontSize="12.5"
                                           Foreground="{StaticResource OnlineGreen}"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="✅  Media Foundation 低延迟 H.264 / HEVC 编解码管线：已就绪"
                                           FontSize="12.5"
                                           Foreground="{StaticResource OnlineGreen}"
                                           Margin="0,0,0,8" />

                                <Grid>
                                    <TextBlock x:Name="AdminStatusText"
                                               Text="ℹ  管理员窗口控制权限 (UIPI)：当前以普通用户运行（可正常操控微信/浏览器/常规软件；如需操控管理员窗口可提权重启）"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,130,0" />
                                    <Button x:Name="RelaunchAdminBtn"
                                            Content="以管理员重启"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Padding="12,5"
                                            FontSize="11.5"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="RelaunchAdminBtn_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Trusted Peers Whitelist -->
                        <Border x:Name="TrustedPeersCard" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TrustedPeersHeading"
                                           Text="已信任免密证书设备白名单 (0)"
                                           FontSize="14.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,10" />
                                <StackPanel x:Name="TrustedPeersListPanel" />
                            </StackPanel>
                        </Border>

                        <!-- 5. Software Version & Auto-Update -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="版本维护与自动更新" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SettingsCurrentVerText"
                                                   Text="当前客户端版本：v0.7.1"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="SettingsUpdateSummaryText"
                                                   Text="  ·  尚未检查更新"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="ViewReleaseNotesBtn"
                                                Content="查看更新内容 / 一键更新"
                                                Visibility="Collapsed"
                                                Padding="11,5"
                                                FontSize="11.5"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="OpenUpdateDialogBtn_Click" />
                                        <Button x:Name="CheckUpdatesNowBtn"
                                                Content="立即检查更新"
                                                Padding="12,5"
                                                FontSize="11.5"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="CheckUpdatesNowBtn_Click" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="自动检查策略：" Width="110" VerticalAlignment="Center" FontSize="12.5" />
                                    <ComboBox x:Name="UpdatePolicyCombo" Width="250" Height="28" SelectionChanged="UpdatePolicyCombo_SelectionChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================== -->
                <!-- PAGE 4: 网络与日志 (WAN Config + AI Deploy + Logs)        -->
                <!-- ======================================================== -->
                <Grid x:Name="PageNetworkLogs" Visibility="Collapsed" Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 5-Layer WAN Configuration -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="跨网连接与服务域名配置（局域网 mDNS ➔ 原生公网 IPv6 ➔ STUN 打洞 ➔ 专属中继 ➔ 全球节点保底）"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="设备码寻址 (Coord):" VerticalAlignment="Center" FontSize="12.5" />
                                <TextBox x:Name="WanCoordBox" Grid.Column="1" FontFamily="Consolas" Style="{StaticResource RoundedTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="打洞与中继 (Relay):" VerticalAlignment="Center" FontSize="12.5" />
                                <TextBox x:Name="WanRelayBox" Grid.Column="1" FontFamily="Consolas" Style="{StaticResource RoundedTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="中继鉴权 Token:" VerticalAlignment="Center" FontSize="12.5" />
                                <TextBox x:Name="WanTokenBox" Grid.Column="1" FontFamily="Consolas" Style="{StaticResource RoundedTextBoxStyle}" views:UiAssist.Placeholder="可选鉴权令牌" />
                            </Grid>

                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="WanFallbackCheck" Style="{StaticResource ModernToggleSwitchStyle}" Content="保留全球公共节点作为终极兜底" Margin="0,0,22,0" FontSize="12" />
                                    <CheckBox x:Name="WanInsecureCheck" Style="{StaticResource ModernToggleSwitchStyle}" Content="允许自签 TLS 证书" FontSize="12" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="使用公共服务域名"
                                            Padding="12,5"
                                            FontSize="11.5"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ResetPublicWanBtn_Click" />
                                    <Button Content="保存网络配置"
                                            Padding="12,5"
                                            FontSize="11.5"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveWanBtn_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Self-Host AI Deploy Prompt -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖧  自建专属机房 · AI 自动部署提示词" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock x:Name="CopiedPromptBadge" Text="  ✓ 已复制提示词" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource OnlineGreen}" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="仅复制提示词" Padding="10,4" FontSize="11" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="CopyDeployPromptOnlyBtn_Click" />
                                    <Button Content="复制提示词并打开 GitHub" Padding="10,4" FontSize="11" Style="{StaticResource PrimaryButtonStyle}" Click="CopyDeployPromptOpenGithubBtn_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="7" Padding="10,6" MaxHeight="66">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="DeployPromptText"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="#0F172A"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostic Log Toolbar -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="实时分级诊断日志" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="LogLevelCombo" Width="144" Height="30" SelectionChanged="LogLevelCombo_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="复制诊断报告" Padding="11,5" FontSize="11.5" Margin="0,0,6,0" Style="{StaticResource PrimaryButtonStyle}" Click="CopyDiagLogsBtn_Click" />
                            <Button Content="打开日志目录" Padding="11,5" FontSize="11.5" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="OpenLogDirBtn_Click" />
                            <Button Content="清空" Padding="11,5" FontSize="11.5" Style="{StaticResource SecondaryButtonStyle}" Click="ClearLogsBtn_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Log Console -->
                    <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="8">
                        <ListBox x:Name="LogsListBox"
                                 Style="{StaticResource DarkLogListBoxStyle}"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 Foreground="#E2E8F0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>

            </Grid>

            <Border Grid.Row="3" Background="{StaticResource DividerBrush}" />

            <!-- Bottom Status Bar -->
            <Grid Grid.Row="4" Background="#F1F5F9" Margin="0">
                <Grid Margin="18,7,18,7">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="BottomStatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,8,0" />
                        <TextBlock x:Name="BottomStatusText"
                                   Text="就绪"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="600" />
                    </StackPanel>
                    <Button Content="复制诊断日志"
                            HorizontalAlignment="Right"
                            Padding="10,3"
                            FontSize="11"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CopyDiagLogsBtn_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
