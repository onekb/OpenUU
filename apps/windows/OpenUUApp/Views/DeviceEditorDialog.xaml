<Window x:Class="OpenUU.Views.DeviceEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenUU.Views"
        Title="管理受控端设备"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource CardBg}"
        UseLayoutRounding="True">
    <StackPanel Margin="24">
        <TextBlock x:Name="DialogHeading"
                   Text="添加受控端设备"
                   FontSize="17"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,16" />

        <TextBlock Text="设备备注名称" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
        <TextBox x:Name="AliasBox"
                 Style="{StaticResource RoundedTextBoxStyle}"
                 ToolTip="例如：家里主机 / 公司 Mac Studio / 工作室电脑"
                 Margin="0,0,0,12" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="92" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="设备代码 / openuu://直连串 / IP或域名" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                <views:SmartTargetTextBox x:Name="TargetBox"
                                          Style="{StaticResource RoundedTextBoxStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="端口" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                <TextBox x:Name="PortBox"
                         Text="39481"
                         FontFamily="Consolas"
                         Style="{StaticResource RoundedTextBoxStyle}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="保存访问密码（保存后一键免输连接）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordSecureBox"
                                 Grid.Column="0"
                                 FontFamily="Consolas"
                                 Style="{StaticResource RoundedPasswordBoxStyle}"
                                 PasswordChanged="PasswordSecureBox_PasswordChanged" />
                    <TextBox x:Name="PasswordBox"
                             Grid.Column="0"
                             Visibility="Collapsed"
                             FontFamily="Consolas"
                             Style="{StaticResource RoundedTextBoxStyle}"
                             TextChanged="PasswordBox_TextChanged" />
                    <Button x:Name="ToggleDialogPwEyeBtn"
                            Grid.Column="2"
                            Content="👁"
                            ToolTip="点击显示/隐藏访问密码"
                            Padding="9,5"
                            FontSize="12"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ToggleDialogPwEyeBtn_Click" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="所属分组" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
                <ComboBox x:Name="GroupCombo"
                          Height="34"
                          VerticalContentAlignment="Center"
                          IsEditable="True" />
            </StackPanel>
        </Grid>

        <TextBlock Text="备注说明（可选）" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
        <TextBox x:Name="NotesBox"
                 Style="{StaticResource RoundedTextBoxStyle}"
                 Margin="0,0,0,12" />

        <CheckBox x:Name="FavoriteCheck"
                  Content="星标置顶到常用列表首位"
                  Foreground="{StaticResource TextPrimary}"
                  FontSize="12.5"
                  Margin="0,0,0,18" />

        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="84"
                    Margin="0,0,10,0"
                    Click="CancelBtn_Click" />
            <Button x:Name="SaveBtn"
                    Content="保存设备"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="104"
                    Click="SaveBtn_Click" />
        </StackPanel>
    </StackPanel>
</Window>
