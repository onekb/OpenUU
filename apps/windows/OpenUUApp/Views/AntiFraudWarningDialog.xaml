<Window x:Class="OpenUU.Views.AntiFraudWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="防诈骗安全警示"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CardBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="1"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="AntiFraudConfirmBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerRed}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#94A3B8" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FECACA"
            BorderThickness="1.5"
            CornerRadius="12"
            Background="{StaticResource CardBg}"
            ClipToBounds="True">
        <StackPanel>
            <!-- Top Draggable Warning Header -->
            <Border Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0"
                    Padding="22,16"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="10"
                            Background="{StaticResource DangerRed}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <TextBlock Text="⚠"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-2,0,0" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="防诈骗安全警示"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#991B1B" />
                        <TextBlock Text="开启本机被控前，请务必仔细阅读以下反诈提醒"
                                   FontSize="11.5"
                                   Foreground="#B91C1C"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main Warning Content -->
            <StackPanel Margin="22,18,22,20">
                <!-- Core Highlight Banner -->
                <Border Background="#FEF2F2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="14,11"
                        Margin="0,0,0,14">
                    <TextBlock Text="凡是陌生人要求您安装或使用本程序开启远程控制，100% 是电信网络诈骗！谨防受骗！"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerRed}"
                               TextWrapping="Wrap"
                               LineHeight="20" />
                </Border>

                <!-- Point 1: Public Authority Impersonation -->
                <StackPanel Margin="0,0,0,11">
                    <TextBlock Text="• 公检法等国家公权力机关绝不会让您使用本程序！"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,3" />
                    <TextBlock Text="公安、检察院、法院、银保监、税务等任何机关绝不会“线上办案”，更不会以涉嫌违法、安全账户清查、征信修复等名义要求您开启屏幕共享或远程控制。"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="11,0,0,0" />
                </StackPanel>

                <!-- Point 2: Fake Customer Support / Refund Scams -->
                <StackPanel Margin="0,0,0,11">
                    <TextBlock Text="• 陌生“客服 / 理赔 / 退订扣费”引导远控统统都是骗子！"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,3" />
                    <TextBlock Text="凡自称“关闭微信/抖音百万保障或保险自动扣费、电商快递理赔、机票退改签、网贷提额、刷单返利”并引导开启被控的，请立即挂断电话！"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="11,0,0,0" />
                </StackPanel>

                <!-- Point 3: Full Screen & Input Access Warning -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="• 开启被控等同交出电脑画面与键鼠控制权"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,3" />
                    <TextBlock Text="请仅对您本人设备或完全信任的亲友同事开启；远控期间切勿查看短信验证码，切勿输入银行卡、支付宝或微信支付密码！"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="11,0,0,0" />
                </StackPanel>

                <!-- 96110 Hotline Strip -->
                <Border Background="#FFFBEB"
                        BorderBrush="#FDE68A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,16">
                    <TextBlock Text="📞 如遇他人诱导开启，请立即点击「取消开启」并拨打 96110 反诈专线核实。"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="#92400E"
                               TextWrapping="Wrap" />
                </Border>

                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,14" />

                <!-- Opt-out Checkbox (Unchecked by default) + Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="DontShowAgainCheck"
                              Grid.Column="0"
                              Content="下次不再出现此提示"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              FontSize="12.5"
                              Foreground="{StaticResource TextSecondary}"
                              Cursor="Hand" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelBtn"
                                Content="取消开启"
                                IsCancel="False"
                                IsDefault="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,8"
                                Margin="0,0,10,0"
                                Click="CancelBtn_Click" />
                        <Button x:Name="ConfirmBtn"
                                Content="我知道了 (3s)"
                                Width="132"
                                IsEnabled="False"
                                IsDefault="False"
                                Style="{StaticResource AntiFraudConfirmBtnStyle}"
                                Click="ConfirmBtn_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
